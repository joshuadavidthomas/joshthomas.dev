#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Amp's base image supplies Node and pnpm; package.json pins pnpm's version.
echo "Installing locked dependencies"
time pnpm install --frozen-lockfile

echo "Preparing local environment"
if [[ ! -f .dev.vars ]]; then
  cp -- .dev.vars.example .dev.vars
fi

# Generate Astro's content types so TypeScript checks pass before `astro dev`
# or `astro build` has ever run.
npx astro sync --force > /dev/null
