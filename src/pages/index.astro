---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { entries } from '@/lib/content';
import { renderInline, renderMarkdown, renderMarkdownSections } from '@/lib/markdown';
import DatedEntry from '@/components/DatedEntry.astro';
import InlineAdd from '@/components/admin/InlineAdd.astro';
import InlineDelete from '@/components/admin/InlineDelete.astro';
import InlineHead from '@/components/admin/InlineHead.astro';
import { ArrowUpRight, Mail, Rss } from '@lucide/astro';

const writing = (await entries()).slice(0, 5);
// Work, Projects, and Community are Markdown documents of headed items, laid out below as lists.
const sectioned = new Set(['prose', 'projects', 'community']);
const sections = await Promise.all(
	(await getCollection('home'))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (entry) => ({
			...entry,
			html: sectioned.has(entry.data.kind) ? '' : await renderMarkdown(entry.body ?? '', entry.data.kind === 'intro' ? 1 : 2),
			tree: sectioned.has(entry.data.kind) ? await renderMarkdownSections(entry.body ?? '', 2) : undefined
		}))
);
---

<BaseLayout description="The personal website of Josh Thomas, a web developer living in Alabama.">
	<div class="home">
			{sections.map(({ id, data, html, tree }) => data.kind === 'intro' ? (
				<header class="intro" id="about">
					{data.subtitle && <p class="location">{data.subtitle}</p>}
					<div class="markdown intro-copy" set:html={html} />
				</header>
			) : data.kind === 'contact' ? (
				<footer>
					<div class="markdown" set:html={html} />{' '}
					{data.link && <a href={data.link.href}><Mail size={14} class="inline-icon" aria-hidden="true" /> {data.link.label}</a>}
				</footer>
			) : (
				<section aria-labelledby={id} data-kind={data.kind}>
					<div class="section-heading">
						<h2 id={id}>{data.title}</h2>
						{data.subtitle && <span>{data.subtitle}</span>}
						{data.kind === 'writing' && data.link && <a href={data.link.href}><Rss size={14} class="inline-icon" aria-hidden="true" /> {data.link.label}</a>}
					</div>
					{/* Each company's roles; a role's first paragraph is its dates. */}
					{data.kind === 'prose' && tree && <div class="markdown work">{tree.sections.map((company) => (
						<section class="company">
							<Fragment set:html={company.heading} />
							{company.sections.map((role) => (
								<article class="role">
									<header><Fragment set:html={role.heading} /><p class="admin-only role-company" set:html={company.title} /><Fragment set:html={role.blocks[0]} /></header>
									<div class="role-description" set:html={role.blocks.slice(1).join('')} />
								</article>
							))}
						</section>
					))}</div>}
					{/* Categories of projects, each with its blurb. */}
					{data.kind === 'projects' && tree && <div class="markdown projects">
						<Fragment set:html={tree.blocks.join('')} />
						{tree.sections.map((category) => (
							<section class="category">
								<Fragment set:html={category.heading + category.blocks.join('')} />
								<InlineHead columns={['Name', 'Description']} />
								<ul>{category.sections.map((project) => (
									<li><Fragment set:html={project.heading} /><div class="item-description" set:html={project.blocks.join('')} /><InlineDelete noun="project" label={project.text} /></li>
								))}</ul>
								<InlineAdd noun="project" nouns="projects" />
							</section>
						))}
					</div>}
					{data.kind === 'community' && tree && <div class="markdown community">
						<Fragment set:html={tree.blocks.join('')} />
						<InlineHead columns={['Organization', 'Role']} />
						<ul>{tree.sections.map((organization) => (
							<li><Fragment set:html={organization.heading} /><div class="item-description" set:html={organization.blocks.join('')} /><InlineDelete noun="membership" label={organization.text} /></li>
						))}</ul>
						<InlineAdd noun="membership" nouns="memberships" />
						{data.note && <p class="note" set:html={renderInline(data.note)} />}
					</div>}
					{data.kind === 'links' && <>
						<InlineHead columns={['Site', 'URL']} />
						<ul class="flex flex-wrap gap-x-6 gap-y-3">{data.links?.map((link) => (
							<li><a href={link.href} rel="me">{link.label}</a><span class="admin-only admin-url">{link.href.replace(/^https:\/\//, '')}</span><InlineDelete noun="link" label={link.label} /></li>
						))}</ul>
						<InlineAdd noun="link" nouns="links" />
					</>}
					{data.kind === 'dated-list' && <>
						<InlineHead columns={['Title', 'Event', 'Year']} />
						<ul>{data.items?.map((item) => (
							<li><DatedEntry {...item} /><InlineDelete noun="talk" label={item.title} /></li>
						))}</ul>
						<InlineAdd noun="talk" nouns="talks" />
					</>}
					{data.kind === 'writing' && <ul class="writing-list">{writing.map((entry) => (
						<li><DatedEntry title={entry.title} href={entry.url} subtitle={entry.type === 'til' ? `TIL / ${entry.category}` : undefined} date={String(new Date(entry.date).getUTCFullYear())} datetime={entry.date.slice(0, 10)} /></li>
					))}</ul>}
					{data.kind === 'writing' && <p class="more"><a href="/blog/">Writing archive <ArrowUpRight size={14} class="inline-icon" aria-hidden="true" /></a></p>}
					{data.kind === 'projects' && <p class="more"><a href="/projects/">Project statistics & contributions <ArrowUpRight size={14} class="inline-icon" aria-hidden="true" /></a></p>}
					{data.kind !== 'writing' && data.link && <p class="more"><a href={data.link.href}>{data.link.label} <ArrowUpRight size={14} class="inline-icon" aria-hidden="true" /></a></p>}
				</section>
			))}
	</div>
</BaseLayout>

<style>
	h2, p, .markdown :global(p), .markdown :global(h3), .markdown :global(h4) { margin: 0; }
	.markdown :global(h3), .markdown :global(h4) { line-height: 1.3; }
	h2 { color: var(--heading); }
	.location { color: var(--heading); font-size: 21px; line-height: 1.4; letter-spacing: -.3px; }
	.intro-copy :global(p) { margin-top: 20px; }
	.markdown :global(.header-anchor) { display: none; }
	.markdown :global(strong) { color: var(--heading); font-weight: 600; }
	section[data-kind] { margin-top: 52px; }
	.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--rule); padding-bottom: 11px; margin-bottom: 20px; }
	h2 { font-size: 21px; font-weight: 650; letter-spacing: -.4px; }
	.section-heading > a, .section-heading > span { font-size: 13px; color: var(--muted); }
	.work { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 20px; }
	.company, .role, .role > header { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; align-items: baseline; }
	.work :global(h3) { grid-column: 1 / -1; font-size: 16px; font-weight: 600; color: var(--heading); }
	.company + .company > :global(h3) { margin-top: 36px; }
	.work :global(h3 a) { text-decoration: none; }
	.work :global(h4) { margin-top: 28px; font-size: 15px; font-weight: 600; color: var(--heading); }
	.role > header > :global(p:last-child) { margin-top: 28px; font-size: 12px; color: var(--muted); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
	.company > :global(h3) + .role > header > :global(*) { margin-top: 12px; }
	.role-description { grid-column: 1 / -1; }
	.role-description :global(p) { margin-top: 16px; font-size: 15px; }
	.projects :global(h3) { margin: 36px 0 8px; font-size: 17px; font-weight: 600; color: var(--ink); }
	.projects :global(h4) { margin-top: 15px; font-size: 15px; font-weight: 600; color: var(--heading); overflow-wrap: anywhere; }
	.projects :global(h4 a) { text-decoration: none; }
	.projects :global(h4 a:hover) { text-decoration: underline; }
	.projects :global(p) { font-size: 14px; line-height: 1.55; color: var(--muted); margin-top: 1px; }
	.projects :global(h3 + p) { margin-bottom: 20px; color: var(--ink); }
	.projects :global(> p:first-child) { margin: 0 0 24px; font-size: 15px; line-height: 1.65; color: inherit; }
	.community :global(h3) { font-size: 15px; font-weight: 600; margin-top: 16px; }
	.community :global(h3 a) { text-decoration: none; }
	.community :global(p) { font-size: 14px; color: var(--muted); }
	.community .note { margin-top: 20px; font-size: 15px; color: inherit; }
	.more { margin-top: 26px; font-size: 14px; }
	ul { list-style: none; margin: 0; padding: 0; }
	footer { margin-top: 52px; font-size: 14px; }
	footer .markdown, footer .markdown :global(p) { display: inline; }
	footer > a { white-space: nowrap; }
	@media (max-width: 600px) {
		.location { font-size: 18px; }
		.work { column-gap: 10px; }
		.section-heading { flex-wrap: wrap; gap: 4px 16px; }
		section[data-kind] { margin-top: 40px; }
	}
</style>
