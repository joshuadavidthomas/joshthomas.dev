---
import type { GetStaticPathsOptions, Page } from 'astro';
import { Rss } from '@lucide/astro';
import BlogList from '@/components/BlogList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BLOG_PAGE_SIZE, entries, type Entry } from '@/lib/content';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	return paginate(await entries(), { pageSize: BLOG_PAGE_SIZE });
}

const { page } = Astro.props as { page: Page<Entry> };
const isFirstPage = page.currentPage === 1;
const title = isFirstPage ? 'Writing' : `Writing — Page ${page.currentPage}`;
const heading = isFirstPage ? 'Writing' : `Writing page ${page.currentPage}`;
---

<BaseLayout {title} description="Writing and Today I Learned notes from Josh Thomas.">
	<h1 class="sr-only">{heading}</h1>
	<div class="feed mb-6 text-right">
		<a href="/feeds/blog.xml" class="inline-block text-[13px] text-muted"><Rss size={14} class="inline-icon" aria-hidden="true" /> Feed</a>
	</div>
	<BlogList {page} />
</BaseLayout>
