---
import { env } from 'cloudflare:workers';
import { Download, GitFork, Package, Star } from '@lucide/astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import getProjects from '@/lib/server/projects';
import { THEME_NAMES } from '@/lib/theme';
import { developmentProjectData } from '@/lib/server/projects-dev';

export const prerender = false;
// Only a theme link (?theme=<name>, which the theme script then removes) is allowed to skip the canonical redirect.
const themeLink = [...Astro.url.searchParams.keys()].join() === 'theme' && THEME_NAMES.includes(Astro.url.searchParams.get('theme')!);
if (Astro.url.search && !themeLink) return Astro.redirect('/projects/', 308);
let githubRateLimited = false;
let data;
try {
	data = await getProjects(env.GITHUB_TOKEN, env.PACKAGE_STATS, import.meta.env.DEV);
} catch (error) {
	const rateLimitError =
		error instanceof Error &&
		(error.message.includes('rate limit exceeded for https://api.github.com/') ||
			error.message.startsWith('403 '));
	if (!import.meta.env.DEV || !rateLimitError) throw error;
	console.warn('GitHub project data is unavailable in development because the API rate limit was reached.');
	githubRateLimited = true;
	data = developmentProjectData;
}
const { projects, contributions } = data;
if (Astro.cache.enabled) Astro.cache.set({ maxAge: 86400, swr: 604800 });
const number = new Intl.NumberFormat('en-US');

type Project = (typeof projects)[number];
type Stats = { lastDay: number; lastWeek: number; lastMonth: number };
// Every registry a project publishes to, in one shape.
const packages = (project: Project) =>
	[
		project.pypiStats && project.pypiPackage && { registry: 'PyPI', icon: 'devicon-pypi-plain colored', name: project.pypiPackage, url: `https://pypi.org/project/${project.pypiPackage}/`, statsUrl: `https://pypistats.org/packages/${project.pypiPackage}`, stats: project.pypiStats as Stats },
		project.npmStats && project.npmPackage && { registry: 'npm', icon: 'devicon-npm-original-wordmark colored', name: project.npmPackage, url: `https://www.npmjs.com/package/${project.npmPackage}`, statsUrl: `https://npmtrends.com/${project.npmPackage}`, stats: project.npmStats as Stats },
		...project.cratesIOCrates.map((crate: { name: string; stats: Stats }) => ({ registry: 'crates.io', icon: 'devicon-rust-original', name: crate.name, url: `https://crates.io/crates/${crate.name}`, statsUrl: `https://crates.io/crates/${crate.name}`, stats: crate.stats })),
		project.zedStats && project.zedExtension && { registry: 'Zed', icon: 'zed', name: project.zedExtension, url: `https://zed.dev/extensions/${project.zedExtension}`, statsUrl: `https://zed.dev/extensions/${project.zedExtension}`, stats: null, total: project.zedStats.totalDownloads as number }
	].filter(Boolean) as { registry: string; icon: string; name: string; url: string; statsUrl: string; stats: Stats | null; total?: number }[];
const monthlyDownloads = (project: Project) => packages(project).reduce((sum, pkg) => sum + (pkg.stats?.lastMonth ?? 0), 0);

// django.contrib.admin theme: values for the changelist filters.
const registries = (project: Project) => [...new Set(packages(project).map((pkg) => pkg.registry))];
const languageNames = (project: Project) => (project.languages ?? []).map((language: { name: string }) => language.name);
const languageFilters = [...new Set(projects.flatMap(languageNames))].sort((a, b) => a.localeCompare(b));
const registryFilters = ['PyPI', 'npm', 'crates.io', 'Zed'].filter((registry) => projects.some((project) => registries(project).includes(registry)));
---

<BaseLayout title="Projects" description="Open-source projects and contributions from Josh Thomas.">
	<div class="archive space-y-16 text-[14px]">
		<form class="admin-only admin-toolbar" role="search">
			<label for="searchbar"><span class="search-icon" aria-hidden="true"></span><span class="sr-only">Search projects</span></label>
			<input type="text" id="searchbar" size="40" />
			<input type="submit" value="Search" />
		</form>
		<nav class="admin-only admin-filter" aria-labelledby="changelist-filter-header">
			<h2 id="changelist-filter-header">Filter</h2>
			<details open>
				<summary><h3>By language</h3></summary>
				<ul>
					<li class="selected"><a href="#" data-filter="languages" data-value="" aria-current="true">All</a></li>
					{languageFilters.map((language) => <li><a href="#" data-filter="languages" data-value={language}>{language}</a></li>)}
				</ul>
			</details>
			<details open>
				<summary><h3>By registry</h3></summary>
				<ul>
					<li class="selected"><a href="#" data-filter="registries" data-value="" aria-current="true">All</a></li>
					{registryFilters.map((registry) => <li><a href="#" data-filter="registries" data-value={registry}>{registry}</a></li>)}
				</ul>
			</details>
		</nav>
		{githubRateLimited && <p role="status" class="text-sm text-gray-600 sm:text-base dark:text-gray-300">Showing development fixtures because the local GitHub API rate limit was reached.</p>}
		{projects.length > 0 && <section aria-labelledby="projects">
			<h2 id="projects" class="sr-only">Projects</h2>
			<p class="text-sm leading-[1.75] text-gray-600 sm:text-base dark:text-gray-300">
				A collection of projects I've built and <a href="/blog/2025/open-source-is-a-gift/">shared openly</a>. If something catches your attention, dive into the code and help improve it. <a href="https://github.com/joshuadavidthomas?tab=repositories&type=source" target="_blank" rel="noopener noreferrer" class="group">Click here to view more on <span class="ml-0.5 inline-flex items-baseline gap-1 underline decoration-inherit"><GitHubIcon class="my-auto size-3 sm:size-4" />GitHub</span></a>.
			</p>
			<div class="admin-only admin-actions" data-noun="project" data-nouns="projects">
				<label>Action: <select><option value="">---------</option><option value="delete">Delete selected projects</option></select></label>
				<button type="button" class="button">Go</button>
				<span class="admin-action-counter" aria-live="polite">0 of {projects.length} selected</span>
			</div>
			<div class="admin-only admin-results-head">
				<input type="checkbox" id="action-toggle" aria-label="Select all projects" />
				<a href="#" data-sort="text" data-sort-by="h3">Name</a>
				<span aria-hidden="true">Description</span>
				<span aria-hidden="true">Languages</span>
				<a href="#" data-sort="number" data-sort-by=".stars dd" class="sorted descending">Stars</a>
				<a href="#" data-sort="number" data-sort-by=".forks dd">Forks</a>
				<span aria-hidden="true">Package</span>
				<a href="#" data-sort="number" data-sort-attr="data-monthly-downloads">Per month</a>
			</div>
			<div class="project-list mt-10 space-y-16 xs:space-y-12">
				{projects.map((project) => <article class="group relative" aria-labelledby={`project-${project.name}`} data-admin-row data-languages={languageNames(project).join('|')} data-registries={registries(project).join('|')} data-monthly-downloads={monthlyDownloads(project)}>
					<input type="checkbox" class="admin-only admin-action-select" aria-label={`Select ${project.name}`} />
					<h3 id={`project-${project.name}`} class="text-xl/6 font-semibold sm:text-2xl/7"><a href={project.homepage || project.url}><span class="absolute inset-0"></span>{project.name}</a></h3>
					<div class="distribution relative z-10 mt-2 flex w-fit flex-col gap-1.5 xs:gap-1">
						<div class="repository flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-700 dark:text-gray-300">
							<a href={project.url} class="repository-link inline-flex items-center gap-1"><GitHubIcon class="size-3" />{project.fullName}</a>
							<dl class="stats flex items-center gap-3">
								<div class="stars"><dt class="sr-only">Stars</dt><dd class="flex"><a href={`${project.url}/stargazers`} class="inline-flex items-center gap-1"><Star class="size-3 fill-stat-star text-stat-star" aria-hidden="true" />{project.stars}</a></dd></div>
								{project.forks > 0 && <div class="forks hidden xs:block"><dt class="sr-only">Forks</dt><dd class="flex"><a href={`${project.url}/forks`} class="inline-flex items-center gap-1"><GitFork class="size-3 text-stat-fork" aria-hidden="true" />{project.forks}</a></dd></div>}
								{project.releaseDownloads && <div class="release-downloads"><dt class="sr-only">Release downloads</dt><dd class="flex"><a href={`${project.url}/releases`} class="inline-flex items-center gap-1 tabular-nums"><Download class="size-3 text-stat-icon-strong" aria-hidden="true" />{number.format(project.releaseDownloads)}</a></dd></div>}
							</dl>
						</div>
						{packages(project).length > 0 && <ul class="packages flex flex-col gap-1.5 xs:gap-1 has-[>li+li]:grid has-[>li+li]:grid-cols-[auto_1fr] has-[>li+li]:gap-x-4" aria-label="Packages">{packages(project).map((pkg) => <li data-registry={pkg.registry} class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-700 in-[ul:has(>li+li)]:col-span-2 in-[ul:has(>li+li)]:grid in-[ul:has(>li+li)]:grid-cols-subgrid dark:text-gray-300"><dl class="contents">
							<div class="package"><dt class="sr-only">{pkg.registry} package</dt><dd class="flex"><a href={pkg.url} class="inline-flex items-center gap-1">{pkg.icon === 'zed' ? <Package class="size-3" aria-hidden="true" /> : <i class={`${pkg.icon} size-3`} aria-hidden="true"></i>}{pkg.name}</a></dd></div>
							<div class="downloads"><dt class="sr-only">Downloads</dt><dd class="flex items-center gap-3 tabular-nums">{pkg.stats ? <>
								<a href={pkg.statsUrl} class="last-day hidden items-center gap-1 xs:inline-flex"><Download class="size-3 text-stat-icon" aria-hidden="true" /><span>{number.format(pkg.stats.lastDay)}<span class="unit">/day</span></span></a>
								<a href={pkg.statsUrl} class="last-week hidden items-center gap-1 xs:inline-flex"><Download class="size-3 text-stat-icon" aria-hidden="true" /><span>{number.format(pkg.stats.lastWeek)}<span class="unit">/week</span></span></a>
								<a href={pkg.statsUrl} class="last-month inline-flex items-center gap-1"><Download class="size-3 text-stat-icon" aria-hidden="true" /><span>{number.format(pkg.stats.lastMonth)}<span class="unit">/month</span></span></a>
							</> : <a href={pkg.statsUrl} class="total-downloads inline-flex items-center gap-1"><Download class="size-3 text-stat-icon" aria-hidden="true" /><span>{number.format(pkg.total!)}<span class="unit"> downloads</span></span></a>}</dd></div>
						</dl></li>)}</ul>}
					</div>
					{project.description && <p class="mt-3 text-sm text-gray-600 xs:mt-2 sm:text-base dark:text-gray-300">{project.description}</p>}
					{project.languages?.length > 0 && <ul class="languages mt-3 flex flex-wrap items-center gap-2 text-xs text-gray-500 xs:mt-2 dark:text-gray-400" aria-label="Languages">{project.languages.map((language: { name: string; icon: string }) => <li class="inline-flex items-center gap-1" title={language.name}><i class={`${language.icon} text-base`} aria-hidden="true"></i>{language.name}</li>)}</ul>}
					{project.topics?.length > 0 && <ul class="topics mt-2 flex flex-wrap gap-2" aria-label="Topics">{project.topics.map((topic: string) => <li class="inline-flex items-center rounded-md bg-tag-background px-1.5 py-0.5 text-xs font-medium text-tag-text">{topic}</li>)}</ul>}
				</article>)}
			</div>
			<p class="admin-only admin-result-count" data-admin-count="projects">{projects.length} projects</p>
		</section>}

		{contributions.length > 0 && <>
			<hr aria-hidden="true" class="mx-auto w-24 text-section-rule" />
			<section aria-labelledby="contributions">
				<h2 id="contributions" class="sr-only">Open Source Contributions</h2>
				<p class="text-sm leading-[1.75] text-gray-600 sm:text-base dark:text-gray-300">Here are some contributions I've made to other open source projects. <a href="https://github.com/search?q=type%3Apr+author%3Ajoshuadavidthomas+is%3Apublic+-user%3Ajoshuadavidthomas&type=pullrequests&s=created&o=desc" target="_blank" rel="noopener noreferrer" class="group">Click here to view more on <span class="ml-0.5 inline-flex items-baseline gap-1 underline decoration-inherit"><GitHubIcon class="my-auto size-3 sm:size-4" />GitHub</span></a>.</p>
				<div class="admin-only admin-results-head" aria-hidden="true"><span>Pull request</span><span>Repository</span></div>
				<div class="contribution-list mt-10 space-y-8">{contributions.map((contribution: { number: number; repoUrl: string; repoFullName: string; url: string; title: string }) => <article class="group relative" aria-labelledby={`contribution-${contribution.number}`}>
					<dl class="repository mb-1 flex items-center gap-2 text-xs text-gray-700 dark:text-gray-300"><div><dt class="sr-only">Repository</dt><dd class="flex"><a href={contribution.repoUrl} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1"><GitHubIcon class="size-3" />{contribution.repoFullName}</a></dd></div></dl>
					<h3 id={`contribution-${contribution.number}`} class="text-lg/6 font-semibold sm:text-xl/7"><a href={contribution.url} target="_blank" rel="noopener noreferrer"><span class="absolute inset-0"></span>{contribution.title} <span class="text-base font-normal text-stat-number tabular-nums group-hover:text-inherit sm:text-lg">(#{contribution.number})</span></a></h3>
				</article>)}</div>
				<p class="admin-only admin-result-count">{contributions.length} pull requests</p>
			</section>
		</>}
	</div>
</BaseLayout>

<style>
	:is(p, div, dl, ul) { color: var(--muted); }
	p { font-size: 14px; line-height: 1.65; }
	h3 { color: var(--heading); font-size: 16px; line-height: 1.3; }
	h3 a { text-decoration: none; }
	:is(a, span) { overflow-wrap: anywhere; }
	.inline-flex { flex-wrap: wrap; }
	article + article { margin-top: 28px; }
</style>
