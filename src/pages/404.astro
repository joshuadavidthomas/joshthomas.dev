		<p class="text-sm font-semibold">404</p>
		<h1 class="mt-2 text-4xl font-bold">Page not found</h1>
		<p class="mt-4 text-gray-600 dark:text-gray-300">The requested page could not be loaded.</p>
		<a class="mt-8 inline-block" href="/">Return home</a>
	</section>
</BaseLayout>
