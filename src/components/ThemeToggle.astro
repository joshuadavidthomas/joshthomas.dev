---
import { Palette, RotateCcw } from '@lucide/astro';

const choices = [
	{ name: 'Parchment', mode: 'light', theme: 'default', colors: ['--light-accent', '--light-paper', '--light-ink', '--light-muted'] },
	{ name: 'Ember', mode: 'dark', theme: 'default', colors: ['--dark-accent', '--dark-paper', '--dark-ink', '--dark-muted'] },
	{ name: 'Tokyo Night Day', mode: 'light', theme: 'tokyo-night', colors: ['--color-tokyonight-day-blue', '--color-tokyonight-day-bg', '--color-tokyonight-day-fg', '--color-tokyonight-day-fg-dark'] },
	{ name: 'Tokyo Night Moon', mode: 'dark', theme: 'tokyo-night', colors: ['--color-tokyonight-moon-blue', '--color-tokyonight-moon-bg', '--color-tokyonight-moon-fg', '--color-tokyonight-moon-fg-dark'] },
	{ name: 'Catppuccin Latte', mode: 'light', theme: 'catppuccin', colors: ['--color-catppuccin-latte-mauve', '--color-catppuccin-latte-base', '--color-catppuccin-latte-text', '--color-catppuccin-latte-subtext-0'] },
	{ name: 'Catppuccin Mocha', mode: 'dark', theme: 'catppuccin', colors: ['--color-catppuccin-mocha-mauve', '--color-catppuccin-mocha-surface-0', '--color-catppuccin-mocha-text', '--color-catppuccin-mocha-subtext-0'] },
	{ name: 'Dracula', mode: 'dark', theme: 'dracula', colors: ['--color-dracula-purple', '--color-dracula-bglight', '--color-dracula-fg', '--color-dracula-selection'] }
];
---

<button id="theme-toggle" popovertarget="theme-menu" aria-label="Choose appearance" class="fixed top-5 right-5 z-10 m-0 grid size-10 cursor-pointer place-items-center rounded-control border border-rule bg-paper p-0 text-muted hover:border-muted hover:text-heading" type="button">
	<Palette class="size-4" aria-hidden="true" />
</button>

<div id="theme-menu" popover class="fixed top-[68px] right-5 bottom-auto left-auto m-0 max-h-[calc(100dvh-88px)] w-48 max-w-[calc(100vw-40px)] grid-rows-[auto_auto_minmax(0,1fr)] overflow-hidden rounded-lg border border-rule bg-menu-background p-1.5 text-sm text-ink [&:popover-open]:grid" role="group" aria-label="Appearance">
	<button type="button" data-theme-preference="system" class="theme-option"><RotateCcw class="size-4" aria-hidden="true" /> Reset to default</button>
	<hr class="my-1.5 border-rule" />
	<div class="min-h-0 overflow-y-auto">
		{choices.map(({ name, mode, theme, colors }) => (
			<button type="button" data-theme-preference={mode} data-theme-name={theme} class="theme-option theme-choice">
				<span class="swatches" aria-hidden="true">
					{colors.map((color, index) => <span class="swatch" style={`background: var(${color}); z-index: ${4 - index}`} />)}
				</span>
				<span>{name}</span>
			</button>
		))}
	</div>
</div>

<style>
	.theme-option { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; border-radius: 4px; cursor: pointer; text-align: left; }
	.theme-option:hover { background: var(--tag-background); }
	.theme-option[aria-pressed='true'] { color: var(--accent); font-weight: 600; }
	.theme-choice { flex-direction: column; align-items: flex-start; gap: 6px; }
	.swatches { display: flex; isolation: isolate; }
	.swatch { width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--rule); }
	.swatch + .swatch { margin-left: -7px; }
</style>
