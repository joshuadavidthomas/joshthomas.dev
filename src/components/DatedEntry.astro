---
import { renderInline } from '@/lib/markdown';

interface Props {
	title: string;
	subtitle?: string;
	date: string;
	datetime?: string;
	href: string;
}

const { title, subtitle, date, datetime = date, href } = Astro.props;
---

<div class="dated-entry">
	<div class="description">
		<a class="font-heading" href={href} set:html={renderInline(title)} />
		{subtitle && <p>{subtitle}</p>}
	</div>
	<time datetime={datetime}>{date}</time>
</div>

<style>
	.dated-entry { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-block: 9px; }
	.description { min-width: 0; }
	a { display: block; color: inherit; font-size: 15px; line-height: 1.3; font-weight: 500; text-decoration: none; overflow-wrap: anywhere; }
	a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: var(--link-offset); }
	a:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; }
	p, time { font-size: 12px; color: var(--muted); }
	p { margin: 2px 0 0; }
	time { flex-shrink: 0; white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
