---
import type { Page } from 'astro';
import { CalendarDays } from '@lucide/astro';
import type { Entry } from '@/lib/content';
import { entryTransitionName } from '@/lib/transitions';

type Props = { page: Page<Entry> };
const { page } = Astro.props;
const format = (date: string) =>
	new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(date));
---

<div class="mt-4 space-y-12">
	{page.data.map((entry) => (
		<article class="group relative" data-entry-type={entry.type} transition:name={entryTransitionName(entry.title)}>
			<time datetime={entry.date.slice(0, 10)} class:list={['flex items-baseline gap-2 text-xs text-gray-600 dark:text-gray-200', entry.type === 'post' ? 'sm:text-sm' : 'sm:text-xs']}>
				<CalendarDays class:list={['text-gray-700 dark:text-gray-300', entry.type === 'post' ? 'size-3 sm:size-4' : 'size-2 sm:size-3']} aria-hidden="true" />
				{format(entry.date)}
			</time>
			{entry.type === 'post' ? (
				<>
					<h2 class="mt-2 text-xl/6 font-semibold sm:text-2xl/7"><a href={entry.url}><span class="absolute inset-0"></span><Fragment set:html={entry.titleHtml} /></a></h2>
					{entry.summary && <p class="mt-4 text-sm text-gray-600 sm:text-base dark:text-gray-300">{entry.summary}</p>}
				</>
			) : (
				<h2 class="flex items-baseline-last justify-between gap-8 text-lg font-semibold text-gray-800 sm:text-xl dark:text-gray-100">
					<a href={entry.url}><span class="absolute inset-0"></span><span class="my-auto mr-2 text-tokyonight-day-teal dark:text-tokyonight-moon-teal">TIL</span><Fragment set:html={entry.titleHtml} /></a>
				</h2>
			)}
		</article>
	))}
	{page.lastPage > 1 && (
		<nav class="mt-8 flex items-center justify-between" aria-label="Blog pagination">
			<p class="text-sm text-gray-800 dark:text-gray-200">Page <span class="font-medium">{page.currentPage}</span> of <span class="font-medium">{page.lastPage}</span></p>
			<div class="mt-1 flex gap-4 text-sm">
				{page.url.first && page.url.prev && <span class="flex items-center space-x-2"><a href={page.url.first}>first</a><a href={page.url.prev}>previous</a></span>}
				{page.url.next && page.url.last && <span class="ml-auto flex items-center space-x-2"><a href={page.url.next}>next</a><a href={page.url.last}>last</a></span>}
			</div>
		</nav>
	)}
</div>
