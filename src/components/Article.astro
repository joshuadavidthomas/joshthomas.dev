---
import type { Entry } from '@/lib/content';
import { renderMarkdown } from '@/lib/markdown';
import { entryTransitionName } from '@/lib/transitions';
const { entry } = Astro.props as { entry: Entry };
const html = await renderMarkdown(entry.body, entry.type === 'post' ? 1 : 0);
---

<article class="prose reading">
	<header class="not-prose article-heading" transition:name={entryTransitionName(entry.title)}>
		<h1 class="page-title">
			<Fragment set:html={entry.titleHtml} />
		</h1>
		<time datetime={entry.date.slice(0, 10)}>
			{new Date(entry.date).toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
		</time>
	</header>
	<Fragment set:html={html} />
</article>

<style>
	.article-heading { margin-bottom: 32px; }
	.page-title { margin-bottom: 12px; }
	time { font-size: 13px; color: var(--muted); }
</style>
