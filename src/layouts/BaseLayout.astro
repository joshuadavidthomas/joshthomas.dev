---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '@/lib/assets/me.png';
import Meta from '@/components/Meta.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import favicon from '@/lib/assets/favicon.svg';
import { themeBootstrap } from '@/lib/theme';
import instrumentSansItalic from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-italic.woff2?url';
import instrumentSansNormal from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import stylesheet from '@/lib/styles/style.css?url';

type Props = {
	title?: string;
	description: string;
	type?: 'website' | 'article';
	updated?: string;
};

const { title, description, type, updated } = Astro.props;
const pathname = Astro.url.pathname;
const isWriting = pathname.startsWith('/blog/') || pathname.startsWith('/til/');
const home = (await getCollection('home')).sort((a, b) => a.data.order - b.data.order);
const intro = home.find(({ data }) => data.kind === 'intro');
const navigation = home.filter(({ data }) => !['intro', 'contact'].includes(data.kind));
const homeAnchor = (id: string) => `${pathname === '/' ? '' : '/'}#${id}`;
const navLink = 'no-underline hover:text-accent hover:underline hover:decoration-current aria-[current=location]:text-accent';
const Name = pathname === '/' ? 'h1' : 'p';
const sourceExceptions: Record<string, string> = {
	'/': 'src/pages/index.astro',
	'/projects': 'src/pages/projects/index.astro'
};
const sourcePath = sourceExceptions[Astro.routePattern] ?? `src/pages${Astro.routePattern}.astro`;
---

<!doctype html>
<html lang="en" data-theme-name="default" data-mode-state="system" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<script is:inline set:html={themeBootstrap}></script>
		<Meta {title} {description} {type} {updated} />
		{import.meta.env.PROD && <ClientRouter />}
		<link rel="icon" href={favicon.src} />
		<link rel="alternate" type="application/atom+xml" title="Josh Thomas" href="/feeds/blog.xml" />
		<meta name="author" content="Josh Thomas" />
		<meta property="og:site_name" content="joshthomas.dev" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" href={instrumentSansNormal} as="font" type="font/woff2" crossorigin="anonymous" />
		{import.meta.env.DEV && <link rel="preload" href={instrumentSansItalic} as="font" type="font/woff2" crossorigin="anonymous" />}
		<link rel="stylesheet" href={stylesheet} />
		<link href="mailto:josh@joshthomas.dev" rel="me" />
		<link href="https://github.com/joshuadavidthomas" rel="me" />
		<link href="https://joshthomas.dev/@josh" rel="me" />
		<link href="https://social.joshthomas.dev/@josh" rel="me" />
		{
			import.meta.env.PROD && (
				<>
					<script is:inline>
						window.goatcounter = { no_onload: true };
						document.addEventListener('astro:page-load', () => window.goatcounter?.count?.());
					</script>
					<script is:inline data-goatcounter="https://joshthomasdev.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
				</>
			)
		}
		{
			type === 'article' && (
				<>
					<link rel="preload" href="/static/fonts/monolisa-v2.015/0-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
					<link rel="preload" href="/static/fonts/monolisa-v2.015/1-italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
				</>
			)
		}
		<slot name="head" />
	</head>
	<body>
		<a class="fixed top-3 left-3 z-20 -translate-y-[200%] bg-paper px-3 py-2 focus:translate-y-0" href="#skip">Skip to content</a>
		<ThemeToggle />
		<div class="page">
			<aside class="sidebar" aria-label="Identity and navigation" transition:name="site-sidebar">
				<a href="/" aria-label="Back to home"><Image src={avatar} width={64} height={64} alt="" class="block size-14 rounded-portrait" /></a>
				<Name class="mt-4 font-heading text-[21px]/[1.2] font-[650] tracking-[-0.7px] text-heading compact:mt-0"><a class="no-underline hover:no-underline" href="/">{intro?.data.title}</a></Name>
				<nav class="section-nav mt-8 flex flex-col gap-2 text-[14px] compact:col-span-2 compact:mt-6 compact:flex-row compact:flex-wrap compact:gap-x-4" aria-label="Main navigation">
					<a class={navLink} href={homeAnchor('about')}>About</a>
					{navigation.map((entry) => <a class={navLink} href={entry.data.kind === 'writing' && pathname !== '/' ? '/blog/' : homeAnchor(entry.id)} aria-current={entry.data.kind === 'writing' && isWriting ? 'location' : undefined}>{entry.data.title}</a>)}
				</nav>
			</aside>
			<main id="skip" class="col-start-2 min-w-0 wrap-anywhere compact:col-start-1" tabindex="-1"><slot /></main>
			<footer class="col-start-2 mt-13 flex flex-wrap gap-x-5 gap-y-2 border-t border-rule pt-5 text-[12px] text-muted compact:col-start-1" transition:name="site-footer">
				<a href="/design-system/">Design system</a>
				<span>Built with <a href="https://astro.build/">Astro</a></span>
				<a href={`https://github.com/joshuadavidthomas/joshthomas.dev/tree/main/${sourcePath}`}>Source</a>
			</footer>
		</div>
	</body>
</html>

<script>
	let cleanup = () => {};
	function trackSection() {
		cleanup();
		if (location.pathname !== '/') return;
		const sections = Array.from(document.querySelectorAll<HTMLAnchorElement>('.section-nav a'))
			.map((link) => ({ link, target: document.getElementById(link.hash.slice(1)) }))
			.filter((entry) => entry.target !== null);
		let frame = 0;
		function update() {
			frame = 0;
			// Keep a long section active until the next heading reaches the reading area.
			let active: (typeof sections)[number] | undefined;
			for (const section of sections) {
				if (section.target!.getBoundingClientRect().top <= innerHeight * 0.25) active = section;
			}
			// Short final sections cannot always reach the top quarter of the viewport.
			if (scrollY > 0 && scrollY + innerHeight >= document.documentElement.scrollHeight - 2) {
				active = sections[sections.length - 1];
			}
			for (const section of sections) {
				if (section === active) section.link.setAttribute('aria-current', 'location');
				else section.link.removeAttribute('aria-current');
			}
		}
		function schedule() {
			if (!frame) frame = requestAnimationFrame(update);
		}
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		cleanup = () => {
			window.removeEventListener('scroll', schedule);
			window.removeEventListener('resize', schedule);
			cancelAnimationFrame(frame);
		};
		update();
	}
	trackSection();
	document.addEventListener('astro:page-load', trackSection);
	document.addEventListener('astro:before-swap', () => cleanup());
</script>
