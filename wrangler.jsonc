{
	"name": "joshthomas-dev",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"triggers": {
		"crons": ["17 4 * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "PACKAGE_STATS"
		}
	],
	"env": {
		"staging": {
			"name": "joshthomas-dev-staging",
			"routes": [
				{
					"pattern": "joshthomas.dev",
					"custom_domain": true
				}
			],
			"triggers": {
				"crons": []
			},
			"kv_namespaces": [
				{
					"binding": "PACKAGE_STATS"
				}
			]
		}
	}
}
